  "about": {
    "en": "Billy Belly Chicken is a fast-growing multi-cuisine restaurant focused on delivering high-quality food, excellent customer service, and a clean dining experience. We specialize in chicken-based dishes along with Indian, Chinese, Tandoori, Biryani, and fast-food offerings.",
    "ta": "பில்லி பெல்லி சிக்கன் என்பது தரமான உணவு, சிறந்த வாடிக்கையாளர் சேவை மற்றும் சுத்தமான உணவக அனுபவத்தை வழங்குவதில் கவனம் செலுத்தும் வேகமாக வளர்ந்து வரும் பல்சுவை உணவகம். சிக்கன் உணவுகளுடன் இந்தியன், சைனீஸ், தந்தூரி, பிரியாணி மற்றும் துரித உணவுகளிலும் நாங்கள் சிறப்பு."
  },
  "mission": {
    "en": "Delicious food, consistent quality, hygienic preparation and fast service at affordable prices.",
    "ta": "சுவையான உணவு, நிலையான தரம், சுகாதாரமான தயாரிப்பு மற்றும் மலிவு விலையில் விரைவான சேவை."
  },
  "missionMotto": {
    "en": "Quality • Cleanliness • Speed • Customer Satisfaction",
    "ta": "தரம் • தூய்மை • வேகம் • வாடிக்கையாளர் திருப்தி"
  },
  "vision": {
    "en": "To become one of the most trusted and preferred food destinations by delivering exceptional taste, quality, and service every day.",
    "ta": "ஒவ்வொரு நாளும் சிறந்த சுவை, தரம் மற்றும் சேவையை வழங்கி, மிகவும் நம்பகமான, விரும்பப்படும் உணவு இடங்களில் ஒன்றாக உயர்வது."
